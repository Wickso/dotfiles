// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
    "languages": {
        "Zig": {
            "soft_wrap": "editor_width",
            "inlay_hints": {
                "enabled": true
            }
        }
    },
    "diagnostics": {
        "inline": {
            "enabled": true
        }
    },
    "disable_ai": true,
    "completions": {
        "lsp": true
    },
    "lsp_document_colors": "inlay",
    "show_completion_documentation": true,
    "show_completions_on_input": true,
    "show_whitespaces": "none",
    "indent_guides": {
        "background_coloring": "disabled",
        "coloring": "fixed",
        "active_line_width": 2,
        "line_width": 1
    },
    "tab_size": 4,
    "minimap": {
        "max_width_columns": 110,
        "thumb_border": "left_open",
        "thumb": "always",
        "show": "always"
    },
    "gutter": {
        "breakpoints": true
    },
    "relative_line_numbers": "enabled",
    "autoscroll_on_clicks": true,
    "sticky_scroll": {
        "enabled": true
    },
    "autosave": "off",
    "ui_font_weight": 500.0,
    "ui_font_family": ".ZedSans",
    "buffer_line_height": "standard",
    "buffer_font_weight": 500.0,
    "buffer_font_family": "Monaspace Neon NF",
    "telemetry": {
        "diagnostics": true,
        "metrics": false
    },
    "vim_mode": true,
    "icon_theme": "Monospace Icon Theme - Dark",
    "ui_font_size": 17.0,
    "buffer_font_size": 16.0,
    "theme": {
        "mode": "dark",
        "light": "Everforest Light Soft (regular)",
        "dark": "Everforest Dark Medium (regular)"
    }
}
